{"type":"data","nodes":[null,null,{"type":"data","data":[{"html":1,"title":2,"description":3,"rawMarkdown":4,"slug":5},"\u003Ch2>Plugin Setup\u003C/h2>\n\u003Cdiv class=\"code-block\" data-code=\"use saddle_bevy_e2e::prelude::*;\n\napp.add_plugins(E2EPlugin);\" data-language=\"rust\">\n\t\t\t\t\t\u003Cdiv class=\"shiki-theme-light\">\u003Cpre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#D73A49\">use\u003C/span>\u003Cspan style=\"color:#6F42C1\"> saddle_bevy_e2e\u003C/span>\u003Cspan style=\"color:#D73A49\">::\u003C/span>\u003Cspan style=\"color:#6F42C1\">prelude\u003C/span>\u003Cspan style=\"color:#D73A49\">::*\u003C/span>\u003Cspan style=\"color:#24292E\">;\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#24292E\">app\u003C/span>\u003Cspan style=\"color:#D73A49\">.\u003C/span>\u003Cspan style=\"color:#6F42C1\">add_plugins\u003C/span>\u003Cspan style=\"color:#24292E\">(\u003C/span>\u003Cspan style=\"color:#6F42C1\">E2EPlugin\u003C/span>\u003Cspan style=\"color:#24292E\">);\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\t\t\t\t\t\u003Cdiv class=\"shiki-theme-dark\">\u003Cpre class=\"shiki github-dark\" style=\"background-color:#24292e;color:#e1e4e8\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">use\u003C/span>\u003Cspan style=\"color:#B392F0\"> saddle_bevy_e2e\u003C/span>\u003Cspan style=\"color:#F97583\">::\u003C/span>\u003Cspan style=\"color:#B392F0\">prelude\u003C/span>\u003Cspan style=\"color:#F97583\">::*\u003C/span>\u003Cspan style=\"color:#E1E4E8\">;\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">app\u003C/span>\u003Cspan style=\"color:#F97583\">.\u003C/span>\u003Cspan style=\"color:#B392F0\">add_plugins\u003C/span>\u003Cspan style=\"color:#E1E4E8\">(\u003C/span>\u003Cspan style=\"color:#B392F0\">E2EPlugin\u003C/span>\u003Cspan style=\"color:#E1E4E8\">);\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\t\t\t\t\u003C/div>\u003Cp>The plugin automatically:\u003C/p>\n\u003Cul>\n\u003Cli>Sets \u003Ccode>TimeUpdateStrategy::ManualDuration(1/60s)\u003C/code> for deterministic timing\u003C/li>\n\u003Cli>Registers runner systems in \u003Ccode>E2ESet\u003C/code>\u003C/li>\n\u003C/ul>\n\u003Ch2>System Ordering\u003C/h2>\n\u003Cp>Place \u003Ccode>E2ESet\u003C/code> before your input systems:\u003C/p>\n\u003Cdiv class=\"code-block\" data-code=\"app.configure_sets(Update, E2ESet.before(GameSet::Input));\" data-language=\"rust\">\n\t\t\t\t\t\u003Cdiv class=\"shiki-theme-light\">\u003Cpre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#24292E\">app\u003C/span>\u003Cspan style=\"color:#D73A49\">.\u003C/span>\u003Cspan style=\"color:#6F42C1\">configure_sets\u003C/span>\u003Cspan style=\"color:#24292E\">(\u003C/span>\u003Cspan style=\"color:#6F42C1\">Update\u003C/span>\u003Cspan style=\"color:#24292E\">, \u003C/span>\u003Cspan style=\"color:#6F42C1\">E2ESet\u003C/span>\u003Cspan style=\"color:#D73A49\">.\u003C/span>\u003Cspan style=\"color:#6F42C1\">before\u003C/span>\u003Cspan style=\"color:#24292E\">(\u003C/span>\u003Cspan style=\"color:#6F42C1\">GameSet\u003C/span>\u003Cspan style=\"color:#D73A49\">::\u003C/span>\u003Cspan style=\"color:#6F42C1\">Input\u003C/span>\u003Cspan style=\"color:#24292E\">));\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\t\t\t\t\t\u003Cdiv class=\"shiki-theme-dark\">\u003Cpre class=\"shiki github-dark\" style=\"background-color:#24292e;color:#e1e4e8\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">app\u003C/span>\u003Cspan style=\"color:#F97583\">.\u003C/span>\u003Cspan style=\"color:#B392F0\">configure_sets\u003C/span>\u003Cspan style=\"color:#E1E4E8\">(\u003C/span>\u003Cspan style=\"color:#B392F0\">Update\u003C/span>\u003Cspan style=\"color:#E1E4E8\">, \u003C/span>\u003Cspan style=\"color:#B392F0\">E2ESet\u003C/span>\u003Cspan style=\"color:#F97583\">.\u003C/span>\u003Cspan style=\"color:#B392F0\">before\u003C/span>\u003Cspan style=\"color:#E1E4E8\">(\u003C/span>\u003Cspan style=\"color:#B392F0\">GameSet\u003C/span>\u003Cspan style=\"color:#F97583\">::\u003C/span>\u003Cspan style=\"color:#B392F0\">Input\u003C/span>\u003Cspan style=\"color:#E1E4E8\">));\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\t\t\t\t\u003C/div>\u003Ch2>Scenario Builder\u003C/h2>\n\u003Cdiv class=\"code-block\" data-code=\"let scenario = Scenario::builder(&quot;my_test&quot;)\n    .description(&quot;Optional description&quot;)\n    .then(Action::WaitFrames(60))          // Wait 1 second (60fps)\n    .then(Action::PressKey(KeyCode::KeyW)) // Press W\n    .then(Action::WaitFrames(30))\n    .then(Action::ReleaseKey(KeyCode::KeyW))\n    .then(Action::Screenshot(&quot;after_move&quot;.into()))\n    .build();\" data-language=\"rust\">\n\t\t\t\t\t\u003Cdiv class=\"shiki-theme-light\">\u003Cpre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#D73A49\">let\u003C/span>\u003Cspan style=\"color:#24292E\"> scenario \u003C/span>\u003Cspan style=\"color:#D73A49\">=\u003C/span>\u003Cspan style=\"color:#6F42C1\"> Scenario\u003C/span>\u003Cspan style=\"color:#D73A49\">::\u003C/span>\u003Cspan style=\"color:#6F42C1\">builder\u003C/span>\u003Cspan style=\"color:#24292E\">(\u003C/span>\u003Cspan style=\"color:#032F62\">\"my_test\"\u003C/span>\u003Cspan style=\"color:#24292E\">)\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#D73A49\">    .\u003C/span>\u003Cspan style=\"color:#6F42C1\">description\u003C/span>\u003Cspan style=\"color:#24292E\">(\u003C/span>\u003Cspan style=\"color:#032F62\">\"Optional descr